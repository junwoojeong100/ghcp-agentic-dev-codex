+      }
+      refund.status = "completed";
+      refund.decidedBy = actor.id;
+      record(refund, actor, action, "allowed", "소액 환불 즉시 처리");
+      return { status: 200, body: { refund: structuredClone(refund), message: "환불 처리 완료 (모의 처리)" } };
+    }
+
+    if (actor.id === refund.requestedBy) {
+      record(refund, actor, action, "blocked", "요청자 본인의 승인 및 반려는 허용되지 않음");
+      return failure(403, "SELF_APPROVAL", "요청자와 다른 운영 승인자만 결정할 수 있습니다.");
+    }
+    if (actor.role !== "approver") {
+      record(refund, actor, action, "blocked", "승인 및 반려는 운영 승인자만 할 수 있음");
+      return failure(403, "APPROVER_REQUIRED", "운영 승인자만 결정할 수 있습니다.");
+    }
+    if (action === "reject" && (typeof body.reason !== "string" || !body.reason.trim() || body.reason.trim().length > 200)) {
+      record(refund, actor, action, "blocked", "반려 이유가 없거나 1~200자 범위를 벗어남");
+      return failure(400, "INVALID_REASON", "반려 이유는 공백을 제외하고 1~200자로 입력해 주세요.");
+    }
+
+    refund.status = action === "approve" ? "completed" : "rejected";
     refund.decidedBy = actor.id;
+    if (action === "reject") refund.decisionReason = body.reason.trim();
     refund.updatedAt = clock();
-    return { status: 200, body: { refund: structuredClone(refund), message: "환불 처리 완료 (모의 처리)" } };
+    record(refund, actor, action, "allowed", action === "reject" ? body.reason.trim() : "승인 요청 검토 후 승인");
+    return {
+      status: 200,
+      body: {
+        refund: structuredClone(refund),
+        message: action === "approve" ? "환불을 승인했습니다 (모의 처리)" : "환불 요청을 반려했습니다.",
+      },
+    };
   }
 
   return { handle };
